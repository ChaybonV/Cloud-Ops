# Voorbeeld van het bestand .env.
# Wil je iets aanpassen? Kopieer dit bestand naar .env en verander de waarden.
# .env staat in .gitignore en komt dus nooit op GitHub.
# Zonder .env gebruikt docker-compose.yml de standaardwaarde (poort 8080).

# De poort op je eigen pc waarop het dashboard bereikbaar is.
FRONTEND_PORT=8080

# Geheime sleutels horen ook in .env, nooit in de code.
# Vanaf milestone 4 komt hier bijvoorbeeld de sleutel voor de AI-agent:
# AI_API_KEY=
